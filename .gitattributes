# Normalize source line endings (LF in the repository), never touch binary assets.
* text=auto

*.cs       text eol=crlf
*.csproj   text eol=crlf
*.props    text eol=crlf
*.targets  text eol=crlf
*.slnx     text eol=crlf
*.linq     text eol=crlf
*.ps1      text eol=crlf
*.md       text eol=lf
*.json     text eol=lf
*.yml      text eol=lf

# Dictionaries are read line by line and the lines are the class labels: a CRLF
# checkout would put a stray \r into every label.
*.txt      text eol=lf

*.onnx     binary
*.pdmodel  binary
*.bmp      binary
*.png      binary
*.jpg      binary
*.dll      binary
*.nupkg    binary
*.snupkg   binary
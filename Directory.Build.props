<Project>
  <!--
    Independent NuGet versions. Edit here (and keep build/00-common.linq in sync).
    `dotnet pack -p:Version=` must not flow into referenced projects; see Directory.Build.targets.
  -->
  <PropertyGroup>
    <SSPaddleOCRVersion Condition="'$(SSPaddleOCRVersion)' == ''">1.0.0</SSPaddleOCRVersion>
    <SSPaddleOCRModelProviderVersion Condition="'$(SSPaddleOCRModelProviderVersion)' == ''">1.0.0</SSPaddleOCRModelProviderVersion>
    <SSPaddleOCRModelsTextLineOrientationVersion Condition="'$(SSPaddleOCRModelsTextLineOrientationVersion)' == ''">1.0.0</SSPaddleOCRModelsTextLineOrientationVersion>
    <SSPaddleOCRModelsChineseV6TinyVersion Condition="'$(SSPaddleOCRModelsChineseV6TinyVersion)' == ''">1.0.0</SSPaddleOCRModelsChineseV6TinyVersion>
    <SSPaddleOCRModelsChineseV6SmallVersion Condition="'$(SSPaddleOCRModelsChineseV6SmallVersion)' == ''">1.0.0</SSPaddleOCRModelsChineseV6SmallVersion>
    <SSPaddleOCRModelsChineseV6MediumVersion Condition="'$(SSPaddleOCRModelsChineseV6MediumVersion)' == ''">1.0.0</SSPaddleOCRModelsChineseV6MediumVersion>
    <SSPaddleOCRModelsKoreanV5MobileVersion Condition="'$(SSPaddleOCRModelsKoreanV5MobileVersion)' == ''">1.0.0</SSPaddleOCRModelsKoreanV5MobileVersion>
  </PropertyGroup>

  <!--
    Inference engine: the SimdOnnx source, a vendored checkout at external/SimdOnnx, compiled into
    SS.PaddleOCR with every engine type internal (no engine package to pin; see SimdOnnx
    docs/decisions.md, 2026-11-18). Override SimdOnnxRoot to build against another checkout.
  -->
  <PropertyGroup>
    <SimdOnnxRoot Condition="'$(SimdOnnxRoot)' == ''">$(MSBuildThisFileDirectory)external\SimdOnnx\</SimdOnnxRoot>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>sdcb</Authors>
    <Company>Sdcb</Company>
    <PackageProjectUrl>https://github.com/sdcb/SimdPaddleOCR</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sdcb/SimdPaddleOCR.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>Sdcb;AI;OCR;PaddleOCR;PP-OCRv6</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryType>git</PublishRepositoryType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'SS.PaddleOCR'">
    <Version>$(SSPaddleOCRVersion)</Version>
    <IsPackable>true</IsPackable>
    <Description>Pure C# PP-OCRv5 and PP-OCRv6 inference (DET + CLS + REC). Cross-platform hand-written kernels and GEMM; optional GPU backends over Vulkan and Metal (macOS), .NET 10 only. Very high performance, low memory requirements, and very high accuracy. No Paddle Inference, ONNX Runtime, or OpenCV native libraries. Accepts interleaved BGR24 / RGB24 / BGRA32 / RGBA32.</Description>
    <PackageTags>Sdcb;AI;OCR;PaddleOCR;PP-OCRv5;PP-OCRv6;linqpad-samples</PackageTags>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'SS.PaddleOCR.ModelProvider'">
    <Version>$(SSPaddleOCRModelProviderVersion)</Version>
    <IsPackable>true</IsPackable>
    <Description>OCR model contracts (IPaddleOcrModelProvider / PaddleOcrModelBundle).</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'SS.PaddleOCR.Models.TextLineOrientation'">
    <Version>$(SSPaddleOCRModelsTextLineOrientationVersion)</Version>
    <IsPackable>true</IsPackable>
    <Description>Embedded PP-LCNet text-line orientation (CLS) model for PP-OCR.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'SS.PaddleOCR.Models.ChineseV6Tiny'">
    <Version>$(SSPaddleOCRModelsChineseV6TinyVersion)</Version>
    <IsPackable>true</IsPackable>
    <Description>Embedded PP-OCRv6 tiny Chinese DET+REC+dictionary models.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'SS.PaddleOCR.Models.ChineseV6Small'">
    <Version>$(SSPaddleOCRModelsChineseV6SmallVersion)</Version>
    <IsPackable>true</IsPackable>
    <Description>Embedded PP-OCRv6 small Chinese DET+REC+dictionary models.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'SS.PaddleOCR.Models.ChineseV6Medium'">
    <Version>$(SSPaddleOCRModelsChineseV6MediumVersion)</Version>
    <IsPackable>true</IsPackable>
    <Description>Embedded PP-OCRv6 medium Chinese DET+REC+dictionary models.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'SS.PaddleOCR.Models.KoreanV5Mobile'">
    <Version>$(SSPaddleOCRModelsKoreanV5MobileVersion)</Version>
    <IsPackable>true</IsPackable>
    <Description>Embedded PP-OCRv5 mobile Korean DET+REC+dictionary models.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)assets\icon.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>
</Project>

<Project>
  <!--
    `dotnet pack -p:Version=` is a global property. It would otherwise:
    1) flow into referenced project compiles, and
    2) be returned by NuGet's _GetProjectVersion as the package dependency version
       (that MSBuild call does not honor ProjectReference.GlobalPropertiesToRemove).
    Result: packing SS.PaddleOCR 1.0.1 would depend on ModelProvider 1.0.1.
  -->
  <ItemGroup>
    <ProjectReference Update="@(ProjectReference)">
      <GlobalPropertiesToRemove>%(ProjectReference.GlobalPropertiesToRemove);Version;PackageVersion</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemGroup>

  <Target Name="FixPackProjectReferenceVersions" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Condition="'%(Filename)' == 'SS.PaddleOCR'">
        <ProjectVersion>$(SSPaddleOCRVersion)</ProjectVersion>
      </_ProjectReferencesWithVersions>
      <_ProjectReferencesWithVersions Condition="'%(Filename)' == 'SS.PaddleOCR.ModelProvider'">
        <ProjectVersion>$(SSPaddleOCRModelProviderVersion)</ProjectVersion>
      </_ProjectReferencesWithVersions>
      <_ProjectReferencesWithVersions Condition="'%(Filename)' == 'SS.PaddleOCR.Models.TextLineOrientation'">
        <ProjectVersion>$(SSPaddleOCRModelsTextLineOrientationVersion)</ProjectVersion>
      </_ProjectReferencesWithVersions>
      <_ProjectReferencesWithVersions Condition="'%(Filename)' == 'SS.PaddleOCR.Models.ChineseV6Tiny'">
        <ProjectVersion>$(SSPaddleOCRModelsChineseV6TinyVersion)</ProjectVersion>
      </_ProjectReferencesWithVersions>
      <_ProjectReferencesWithVersions Condition="'%(Filename)' == 'SS.PaddleOCR.Models.ChineseV6Small'">
        <ProjectVersion>$(SSPaddleOCRModelsChineseV6SmallVersion)</ProjectVersion>
      </_ProjectReferencesWithVersions>
      <_ProjectReferencesWithVersions Condition="'%(Filename)' == 'SS.PaddleOCR.Models.ChineseV6Medium'">
        <ProjectVersion>$(SSPaddleOCRModelsChineseV6MediumVersion)</ProjectVersion>
      </_ProjectReferencesWithVersions>
    <_ProjectReferencesWithVersions Condition="'%(Filename)' == 'SS.PaddleOCR.Models.KoreanV5Mobile'">
        <ProjectVersion>$(SSPaddleOCRModelsKoreanV5MobileVersion)</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>
</Project>

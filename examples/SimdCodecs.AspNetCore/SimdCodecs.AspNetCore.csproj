<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SS.PaddleOCR\SS.PaddleOCR.csproj" />
    <ProjectReference Include="..\..\src\models\SS.PaddleOCR.Models.ChineseV6Tiny\SS.PaddleOCR.Models.ChineseV6Tiny.csproj" />
    <ProjectReference Include="..\..\src\models\SS.PaddleOCR.Models.ChineseV6Small\SS.PaddleOCR.Models.ChineseV6Small.csproj" />
    <ProjectReference Include="..\..\src\models\SS.PaddleOCR.Models.ChineseV6Medium\SS.PaddleOCR.Models.ChineseV6Medium.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.18" />
    <PackageReference Include="Sdcb.SimdCodecs" Version="2.0.0" />
  </ItemGroup>
  <Target Name="CopySampleImageToOutput" AfterTargets="CopyFilesToOutputDirectory">
    <MakeDir Directories="$(OutputPath)wwwroot" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\sample.jpg"
          DestinationFiles="$(OutputPath)wwwroot\sample.jpg"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopySampleImageToPublish" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)wwwroot" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\sample.jpg"
          DestinationFiles="$(PublishDir)wwwroot\sample.jpg"
          SkipUnchangedFiles="true" />
  </Target>
</Project>

<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmEnableThreads Condition="'$(WasmEnableThreads)' == ''">true</WasmEnableThreads>
    <RunAOTCompilation Condition="'$(RunAOTCompilation)' == ''">true</RunAOTCompilation>
    <WasmMainJSPath>main.js</WasmMainJSPath>
    <!-- Prevent Directory.Build.targets from packing this benchmark project -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SS.PaddleOCR\SS.PaddleOCR.csproj" />
    <ProjectReference Include="..\..\src\models\SS.PaddleOCR.Models.ChineseV6Tiny\SS.PaddleOCR.Models.ChineseV6Tiny.csproj" />
    <ProjectReference Include="..\..\src\models\SS.PaddleOCR.Models.ChineseV6Small\SS.PaddleOCR.Models.ChineseV6Small.csproj" />
    <ProjectReference Include="..\..\src\models\SS.PaddleOCR.Models.ChineseV6Medium\SS.PaddleOCR.Models.ChineseV6Medium.csproj" />
    <PackageReference Include="Sdcb.SimdCodecs" Version="2.0.0" />
  </ItemGroup>

  <!-- Embed sample.jpg for instant zero-dependency smoke testing -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\examples\sample.jpg" Link="sample.jpg" />
  </ItemGroup>

</Project>
